// ZevaPay — Prisma schema
// PostgreSQL is the source of truth for merchants, devices, accounts and transactions.

generator client {
  provider = "prisma-client"
  output   = "../../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Login identity of a person on the platform.
enum UserRole {
  /// Platform staff with unrestricted access to the admin console.
  PLATFORM_ADMIN
  /// Owner of a merchant account.
  MERCHANT_OWNER
  /// Staff of a merchant account.
  MERCHANT_ADMIN
  /// Merchant staff with limited access.
  MERCHANT_OPERATOR
  /// Read-only merchant staff.
  MERCHANT_VIEWER
}

/// Lifecycle of a merchant organisation.
enum MerchantStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

/// Lifecycle of a connected payment account.
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Connection state of an Android SMS Bridge device.
enum DeviceStatus {
  PENDING
  ONLINE
  OFFLINE
}

/// Processing state of a recorded payment notification.
enum TransactionStatus {
  /// Parsed with high confidence from a provider notification.
  SUCCESS
  /// Recorded but not yet confirmed against the provider.
  PENDING
  /// Parsed with low confidence, needs a human decision.
  REVIEW
  /// The provider notification reported a failure.
  FAILED
}

/// The mobile financial services providers ZevaPay understands.
enum PaymentProvider {
  BKASH
  NAGAD
  ROCKET
  UPAY
}

/// The kind of account held with a provider.
enum AccountType {
  PERSONAL
  MERCHANT
  AGENT
  BUSINESS
}

/// How a session token was issued.
enum SessionType {
  ACCESS
  REFRESH
}

/// Audit trail of sensitive actions.
enum AuditAction {
  REGISTER
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGED
  MERCHANT_STATUS_CHANGED
  ACCOUNT_CREATED
  ACCOUNT_REMOVED
  DEVICE_PAIRED
  DEVICE_DISCONNECTED
  API_KEY_CREATED
  API_KEY_REVOKED
  TRANSACTION_REVIEWED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A person who can sign in.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(MERCHANT_OWNER)
  phone        String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  sessions Session[]
  apiKeys  ApiKey[]
  reviews  Transaction[] @relation("TransactionReviewedBy")
  auditLogs AuditLog[]

  @@index([merchantId])
  @@index([role])
}

/// A merchant organisation — the tenant boundary for all merchant data.
model Merchant {
  id             String         @id @default(cuid())
  businessName   String
  ownerName      String
  email          String
  phone          String?
  country        String         @default("Bangladesh")
  plan           String         @default("Starter")
  status         MerchantStatus @default(PENDING_REVIEW)
  registrationDate DateTime      @default(now())
  lastActiveAt   DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  paymentAccounts PaymentAccount[]
  devices         Device[]
  transactions    Transaction[]
  apiKeys         ApiKey[]
  pairingCodes    PairingCode[]
  auditLogs       AuditLog[]

  @@index([status])
}

/// A connected mobile financial services account.
model PaymentAccount {
  id           String        @id @default(cuid())
  provider     PaymentProvider
  /// Full number. Only a masked form is ever returned by the API.
  accountNumber String
  accountType  AccountType
  label        String
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  devices     Device[]
  transactions Transaction[]
  pairingCodes PairingCode[]

  @@unique([merchantId, provider, accountNumber])
  @@index([merchantId, status])
}

/// An Android SMS Bridge device that reports payment notifications.
model Device {
  id           String       @id @default(cuid())
  name         String
  /// Human-readable device identifier shown in the dashboard.
  deviceId     String       @unique
  status       DeviceStatus @default(PENDING)
  androidVersion String?
  lastActiveAt DateTime     @default(now())
  connectedAt  DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  /// Payment account this device reports notifications for.
  connectedAccountId String?
  connectedAccount   PaymentAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  pairingCodes PairingCode[]

  @@index([merchantId, status])
}

/// A payment notification recorded from a device.
model Transaction {
  id           String            @id @default(cuid())
  /// Human-facing transaction reference, e.g. TXN-100245.
  reference    String            @unique
  provider     PaymentProvider
  /// Amount in BDT.
  amount       Decimal           @db.Decimal(12, 2)
  customerName String?
  customerPhone String?
  status       TransactionStatus @default(PENDING)
  /// The raw notification exactly as the device received it.
  rawNotification String
  /// Parser confidence, 0..1. Below the threshold the row goes to REVIEW.
  confidence    Float            @default(0)
  /// Provider-side transaction identifier extracted from the message.
  providerRef   String?
  occurredAt    DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  accountId String?
  account   PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// Admin or merchant staff member who resolved a REVIEW row.
  reviewedById String?
  reviewedBy   User?   @relation("TransactionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  @@index([merchantId, status])
  @@index([merchantId, occurredAt])
  @@index([provider, occurredAt])
  @@index([status])
}

/// A short-lived pairing code used to bind a device to a merchant.
model PairingCode {
  id        String   @id @default(cuid())
  /// Human-readable code shown in the dashboard, e.g. ZP-4821-KQ.
  code      String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  /// Payment account the device will report notifications for.
  connectedAccountId String?
  connectedAccount   PaymentAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([expiresAt])
}

/// An issued session token.
model Session {
  id           String      @id @default(cuid())
  tokenHash    String      @unique
  type         SessionType @default(ACCESS)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A scoped API key for programmatic access.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  /// Only a prefix is shown after creation; the full value is never returned again.
  keyPrefix   String
  /// SHA-256 hash of the full key.
  keyHash     String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

/// An append-only audit trail of sensitive actions.
model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  metadata  Json?
  ipAddress String?
  createdAt DateTime    @default(now())

  actorId String?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([merchantId, createdAt])
}
